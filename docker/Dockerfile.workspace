FROM slimerl/slime:nightly-dev-20260804a

# 设置工作目录
WORKDIR /root/slime

RUN cd /root/Megatron-LM && pip install -e .
# `pip install -e /root/Megatron-LM` does not register the `megatron` namespace here
# (it resolves to dist-packages megatron-core only), so `megatron.training` is missing for
# Ray worker actors. Add Megatron-LM to sys.path for ALL python processes via a .pth file.
RUN echo /root/Megatron-LM > "$(python -c 'import site; print(site.getsitepackages()[0])')/zzz_megatron_lm.pth"

# 清理原有的 slime 代码
RUN rm -rf /root/slime/*

# 复制本地 /workspace 下的代码到镜像中
# 注意：构建时需要将代码挂载或复制到构建上下文中
COPY . /root/slime/

# 重新安装 slime（开发模式，使用本地代码）
RUN pip install -e . --no-deps
RUN pip install shortuuid

# --- Harbor (ACK sandbox backend) for slime remote-agent RL ---
# release-dev-e5e46809 carries the ACKEnvironment work this example depends on:
# per-claim image override (one generic SandboxSet serves every task image), the
# SSH exec transport (`use_ssh_exec`, which keeps command traffic off the API
# server's pods/exec at high Trial concurrency) including `ssh_server_command` so
# harbor starts sshd in the SandboxSet itself, and SandboxClaim compatibility when
# `sandboxset_prefix` is unique per `ssh_key_scope`.
# Pinned to a branch rather than a commit because the earlier feature branches
# (feat/ack-sandbox-image-override, feat/ack-persistent-exec) were deleted upstream
# once merged, which silently breaks this build step.
# asyncssh (needed by harbor's SSH exec transport, which imports it lazily and
# refuses to run without it) pulls a newer `cryptography` than this base image's
# 41.0.7. That copy is apt-managed and has no RECORD file, so pip cannot uninstall
# it and the build dies with `uninstall-no-record-file`; `--ignore-installed`
# writes the pip-managed copy over it instead. asyncssh is pinned to the version
# this workload was validated against. `kubernetes` (sync client) is needed
# alongside kubernetes_asyncio: ACKEnvironment uses the sync DynamicClient for the
# CRDs.
# NOTE: harbor pulls openai>2.6.1 (sglang pins ==2.6.1); verified harmless at runtime
# (SGLang engines load and serve fine), so we do not re-pin.
RUN git clone --depth 1 -b release-dev-e5e46809 \
        https://github.com/alibaba/harbor.git /root/harbor && \
    pip install -e /root/harbor && \
    pip install --ignore-installed cryptography && \
    pip install asyncssh==2.24.0 kubernetes_asyncio kubernetes

# mbridge is required to convert/bridge qwen3_5 weights (tools/convert_hf_to_torch_dist.py
# imports slime_plugins.mbridge). Pinned to the commit the examples were validated with.
RUN pip install "git+https://github.com/ISEEKYAN/mbridge.git@89eb10887887bc74853f89a4de258c0702932a1c" --no-deps

# Prepare SWE-agent once in the workspace image. The sandbox Pod uses this image
# as an init container and copies the tree to a pod-local emptyDir shared with the
# task container. This is not colocating agent and slime: the init container runs
# in the sandbox Pod and exits before the task container starts. A direct OSS/PVC
# mount is not viable on ACS in this cluster: its CSI injection adds hostPath
# /var/run/csi, which ACS rejects as an unsupported HostPath volume.
RUN python examples/remote_agent/prepare_shared_swe_agent.py \
        --target /opt/sweagent-shared --mount-path /opt/sweagent-shared && \
    /opt/sweagent-shared/venv/bin/python -c "import sweagent" && \
    python -c "from examples.remote_agent.shared_swe_agent import SharedSweAgent"

# Runtime config for the ACK sandbox backend is passed per run via --harbor-env-kwargs;
# see examples/remote_agent/run_terminalbench_config_me.sh for a working set. The two SSH
# Secrets (harbor-ssh-private-keys / harbor-ssh-authorized-keys) must be pre-created in the
# sandbox namespace — harbor deliberately holds no `secrets create` permission.

# 重新安装 int4_qat 内核（如果存在）
RUN if [ -d "/root/slime/slime/backends/megatron_utils/kernels/int4_qat" ]; then \
        cd /root/slime/slime/backends/megatron_utils/kernels/int4_qat && \
        pip install . --no-build-isolation; \
    fi

# 设置工作目录
WORKDIR /root/slime
