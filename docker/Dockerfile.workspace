FROM slimerl/slime:nightly-dev-20260804a

# 设置工作目录
WORKDIR /root/slime

RUN cd /root/Megatron-LM && pip install -e .
# `pip install -e /root/Megatron-LM` does not register the `megatron` namespace here
# (it resolves to dist-packages megatron-core only), so `megatron.training` is missing for
# Ray worker actors. Add Megatron-LM to sys.path for ALL python processes via a .pth file.
RUN echo /root/Megatron-LM > "$(python -c 'import site; print(site.getsitepackages()[0])')/zzz_megatron_lm.pth"

# 清理原有的 slime 代码
RUN rm -rf /root/slime/*

# 复制本地 /workspace 下的代码到镜像中
# 注意：构建时需要将代码挂载或复制到构建上下文中
COPY . /root/slime/

# 重新安装 slime（开发模式，使用本地代码）
RUN pip install -e . --no-deps
RUN pip install shortuuid

# --- Harbor (ACK sandbox over E2B) for slime remote-agent RL ---
# Use the feat/ack-sandbox-image-override branch: it adds E2BEnvironment kwargs
# `sandbox_set_name` + `override_claim_image`, skips the (ACK-manager-unsupported)
# AsyncTemplate.build, and applies the per-claim image override via the gateway key
# `e2b.agents.kruise.io/image`. Verified against ack-sandbox-manager v0.6.7 (commit 63e77d6).
# The full install pulls harbor's runtime deps (e2b SDK, litellm, dirhash, dockerfile-parse,
# tenacity, ...) that the E2B environment + Trial + swe-agent need.
# NOTE: harbor pulls openai>2.6.1 (sglang pins ==2.6.1); this was verified harmless at runtime
# (SGLang engines load and serve fine), so we do not re-pin.
RUN git clone --depth 1 -b feat/ack-sandbox-image-override \
        https://github.com/alibaba/harbor.git /root/harbor && \
    pip install -e /root/harbor && \
    pip install kubernetes_asyncio

# Runtime config to talk to the in-cluster ACK sandbox stack over E2B (override at run time):
#   E2B_API_KEY=<e2b admin key>
#   E2B_API_URL=http://sandbox-manager.sandbox-system:8080      # control plane
#   E2B_SANDBOX_URL=http://sandbox-gateway.sandbox-system:7788  # data plane (router)
#   E2B_VALIDATE_API_KEY=false
# The SandboxSet pool must set spec.runtimes:[{name: agent-runtime}] (injects envd) and,
# for private task images, imagePullSecrets. Per-claim image override is currently broken on
# the ACK controller (in-place update leaves the sandbox state=dead/InplaceUpdating), so bake
# the task image into the SandboxSet and use override_claim_image=false (one pool per image).

# 重新安装 int4_qat 内核（如果存在）
RUN if [ -d "/root/slime/slime/backends/megatron_utils/kernels/int4_qat" ]; then \
        cd /root/slime/slime/backends/megatron_utils/kernels/int4_qat && \
        pip install . --no-build-isolation; \
    fi

# 设置工作目录
WORKDIR /root/slime
